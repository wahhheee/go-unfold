{
  "name": "go-unfold",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wahhheee/go-unfold.git"
  },
  "homepage": "https://wahhheee.github.io/go-unfold/",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/prepare-static.mjs",
    "build:pages": "npm run typecheck && vite build --base=/go-unfold/ && node scripts/prepare-static.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:go": "go -C examples/go test ./...",
    "test:go:vet": "go -C examples/go vet ./...",
    "test:go:race": "go -C examples/go test -race -shuffle=on -count=1 ./...",
    "test:go:fuzz": "go -C examples/go test ./quality -run '^$' -fuzz '^FuzzRoundTrip$' -fuzztime=5s -parallel=2",
    "test:e2e": "playwright test",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "icons": "node scripts/export-icons.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@mdx-js/react": "^3.1.1",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.58.2",
    "@shikijs/rehype": "^3.23.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "prettier": "^3.9.8",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.23.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.0.18"
  }
}
